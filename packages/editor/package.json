{
  "name": "@cosmoslog/editor",
  "version": "0.1.0",
  "description": "React에서 사용하는 Cosmoslog 블록 에디터",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-bubble-menu": "3.32.0",
    "@tiptap/extension-drag-handle": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/static-renderer": "3.32.0",
    "@tiptap/suggestion": "3.32.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
